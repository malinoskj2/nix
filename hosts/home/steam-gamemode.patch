-// Simply include the header with GAMEMODE_AUTO set
-// This will ensure it calls the functions when it's loaded
-#define GAMEMODE_AUTO
+#include <stdlib.h>
+#include <unistd.h>
 #include "gamemode_client.h"
+
+/* Steam and its startup tools inherit LD_PRELOAD, but only games get an app ID.
+ * SteamGameId also covers non-Steam shortcuts whose SteamAppId may be zero. */
+static bool is_game_id(const char *id)
+{
+	return id && *id && strspn(id, "0123456789") == strlen(id) &&
+	       strspn(id, "0") != strlen(id);
+}
+
+static pid_t registered_pid;
+
+__attribute__((constructor)) static void steam_game_start(void)
+{
+	if (!is_game_id(getenv("SteamAppId")) && !is_game_id(getenv("SteamGameId")))
+		return;
+
+	if (gamemode_request_start() == 0)
+		registered_pid = getpid();
+	else
+		fprintf(stderr, "gamemodeauto: %s\n", gamemode_error_string());
+}
+
+__attribute__((destructor)) static void steam_game_end(void)
+{
+	/* A forked child did not register and must not reuse its parent's D-Bus state. */
+	if (registered_pid && registered_pid == getpid() && gamemode_request_end() < 0)
+		fprintf(stderr, "gamemodeauto: %s\n", gamemode_error_string());
+}
