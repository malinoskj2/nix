+// Like macOS, a banner shows its close button only while the pointer is over it.
+void NotificationToast::showCloseButtons(uint32_t notificationId, bool visible) {
+  for (auto& inst : m_instances) {
+    auto* state = findCardState(*inst, notificationId);
+    if (state == nullptr || state->closeButton == nullptr) {
+      continue;
+    }
+    state->closeButton->setOpacity(visible ? 1.0F : 0.0F);
+    if (inst->surface != nullptr) {
+      inst->surface->requestRedraw();
+    }
+  }
+}
