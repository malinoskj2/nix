root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.{groovy,py}]
indent_size = 4

[*.md]
max_line_length = 80

# Blank context lines in patches must keep their exact bytes.
[*.patch]
trim_trailing_whitespace = false
