diff --git a/src/main/claude/structured/launch/nix-thin-home-scope.test.ts b/src/main/claude/structured/launch/nix-thin-home-scope.test.ts
new file mode 100644
index 00000000..e4a5f79c
--- /dev/null
+++ b/src/main/claude/structured/launch/nix-thin-home-scope.test.ts
@@ -0,0 +1,25 @@
+import { expect, it } from 'vitest'
+import { claudeBotSessionOptions } from './claude-bot-session-options'
+import { BotLaunchTools } from '../../../bots/bot-launch-tools'
+import { THIN_HOME_MARKER } from '../../claude-thin-home-options'
+
+const options = (homeChat: boolean) =>
+  claudeBotSessionOptions(
+    {
+      instructions: async () => `Charter ${THIN_HOME_MARKER}`,
+      readOnly: null,
+      record: { sessionId: 'session' },
+      homeChat
+    },
+    [],
+    BotLaunchTools.none,
+    { mcpConfig: false }
+  )
+
+it("guards the bot's Home Chat", async () => {
+  expect((await options(true)).hooks?.PreToolUse).toHaveLength(1)
+})
+
+it('leaves workers and side chats in the bot folder unguarded', async () => {
+  expect(await options(false)).not.toHaveProperty('hooks')
+})
