diff --git a/src/main/claude/session-settings.ts b/src/main/claude/session-settings.ts
new file mode 100644
index 00000000..9378cd71
--- /dev/null
+++ b/src/main/claude/session-settings.ts
@@ -0,0 +1,51 @@
+import { existsSync } from 'node:fs'
+import { dirname, join } from 'node:path'
+import { getSharedManagedScriptPath, writeManagedScript } from '../agent-hooks/installer-utils'
+import { quoteShell } from '../cli/cli-install-path-format'
+
+// Why: ~/.claude/settings.json may be read-only (e.g. a Nix store symlink), so Orca's
+// hooks live in their own file and reach only the Claude sessions Orca starts.
+export function getClaudeSessionSettingsPath(): string {
+  return getSharedManagedScriptPath('claude-settings.json')
+}
+
+export function claudeSessionSettingsArgs(): string[] {
+  const settingsPath = getClaudeSessionSettingsPath()
+  return process.platform !== 'win32' && existsSync(settingsPath)
+    ? ['--settings', settingsPath]
+    : []
+}
+
+function buildClaudeShimScript(settingsPath: string): string {
+  return `#!/usr/bin/env bash
+self_dir=$(cd "$(dirname "\${BASH_SOURCE[0]}")" && pwd -P)
+settings=${quoteShell(settingsPath)}
+IFS=: read -r -a entries <<< "$PATH"
+for dir in "\${entries[@]}"; do
+  [[ -n $dir && -f $dir/claude && -x $dir/claude ]] || continue
+  [[ $(cd "$dir" && pwd -P) == "$self_dir" ]] && continue
+  if [[ -f $settings ]]; then
+    exec "$dir/claude" --settings "$settings" "$@"
+  fi
+  exec "$dir/claude" "$@"
+done
+echo "claude: command not found" >&2
+exit 127
+`
+}
+
+// Why: a `claude` typed into an Orca terminal, or launched by a command override,
+// resolves through PATH, so a shim ahead of the real CLI adds the settings flag.
+export function ensureClaudeSessionShimDir(): string | null {
+  if (process.platform === 'win32') {
+    return null
+  }
+  const settingsPath = getClaudeSessionSettingsPath()
+  const shimDir = join(dirname(settingsPath), 'bin')
+  try {
+    writeManagedScript(join(shimDir, 'claude'), buildClaudeShimScript(settingsPath))
+  } catch {
+    return null
+  }
+  return shimDir
+}
