+function isLineageChildRow(row: Row): boolean {
+  return (row.type === 'item' || row.type === 'folder-workspace') && row.depth > 0
+}
+
+/** In-progress creates land below the project's main worktree and its children, like the rows they become. */
+function afterLeadingMainWorktrees(rows: readonly Row[], start: number): number {
+  let at = start
+  while (at < rows.length) {
+    const row = rows[at]
+    if (row.type !== 'item' || row.depth !== 0 || !row.worktree.isMainWorktree) {
+      break
+    }
+    at++
+    while (at < rows.length && isLineageChildRow(rows[at])) {
+      at++
+    }
+  }
+  return at
+}
