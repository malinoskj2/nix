+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest'
+import { installFakeAppEnvironment } from '../../../../../config/scripts/test-runtime/environment/vitest-host-ports-setup'
+import { mkdirSync, writeFileSync } from 'node:fs'
+import { join } from 'node:path'
+import { createSettings } from '../runtime-home-settings-test-fixtures'
+import {
+  createStore,
+  setupRuntimeHomeTest,
+  teardownRuntimeHomeTest,
+  testState
+} from '../runtime-home-service-test-harness'
+
+vi.mock('electron', () => ({
+  app: {
+    getPath: () => testState.userDataDir
+  }
+}))
+beforeEach(() => installFakeAppEnvironment({ getPath: () => testState.userDataDir }))
+
+vi.mock(import('node:os'), async (importOriginal) => {
+  const actual = await importOriginal()
+  return {
+    ...actual,
+    homedir: () => testState.fakeHomeDir
+  }
+})
+
+vi.mock('../../../../shared/nix-codex-account-homes', () => ({
+  get nixCodexAccountHomes() {
+    return [join(testState.fakeHomeDir, 'sandbox', '.codex')]
+  }
+}))
+
+describe('Codex session discovery in declared account homes', () => {
+  beforeEach(() => {
+    setupRuntimeHomeTest()
+  })
+
+  afterEach(() => {
+    teardownRuntimeHomeTest()
+  })
+
+  it('admits sandbox terminal history through the recognized account homes', async () => {
+    const home = join(testState.fakeHomeDir, 'sandbox', '.codex')
+    const sessions = join(home, 'sessions', '2026', '11', '15')
+    const id = '01a1e048-997e-7d80-afb6-ed8bc8c88fea'
+    const transcript = join(sessions, `rollout-2026-11-15T12-36-56-${id}.jsonl`)
+    mkdirSync(sessions, { recursive: true })
+    writeFileSync(transcript, JSON.stringify({ type: 'session_meta', payload: { id } }) + '\n')
+    const { CodexRuntimeHomeService } = await import('../../runtime-home-service')
+    const service = new CodexRuntimeHomeService(createStore(createSettings({})) as never)
+    const { configureAiVaultSessionSources } = await import('../../../ai-vault/discovery/ai-vault-scan-roots')
+    const { CODEX_CLI_CONVERSATIONS } = await import('../../../codex/history/journal-views/codex-cli-conversations')
+    const importer = CODEX_CLI_CONVERSATIONS.transcriptImport!
+    const selectedAccountHome = { variable: 'CODEX_HOME', path: join(testState.fakeHomeDir, '.codex') }
+    const candidates = () => importer.accountHomeCandidates({ settings: {}, selectedAccountHome })
+    configureAiVaultSessionSources({})
+    expect(candidates()).not.toContainEqual({ variable: 'CODEX_HOME', path: home })
+    configureAiVaultSessionSources({
+      getAdditionalCodexHomePaths: () => service.getHostCodexHomePathsForSessionDiscovery()
+    })
+    try {
+      expect(candidates()).toContainEqual({ variable: 'CODEX_HOME', path: home })
+      const store = importer.conversationStore({
+        accountHome: { variable: 'CODEX_HOME', path: home }, launchEnv: {}
+      })!
+      await expect(importer.admitTranscriptPath({ store, transcriptPath: transcript })).resolves.toBe(transcript)
+      await expect(importer.findTranscript({
+        providerSessionId: id, store, launchEnv: {}, workspaceCwd: testState.fakeHomeDir
+      })).resolves.toBe(transcript)
+      await expect(importer.admitTranscriptPath({
+        store: join(selectedAccountHome.path, 'sessions'), transcriptPath: transcript
+      })).resolves.toBeNull()
+    } finally {
+      configureAiVaultSessionSources({})
+    }
+  })
+})
