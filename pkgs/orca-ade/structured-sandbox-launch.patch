@@ -0,0 +1,33 @@
+import { describe, expect, it, vi } from 'vitest'
+import { resolveStructuredAgentCommand } from './structured-agent-command-resolution'
+
+vi.mock('../../../shared/nix-global-settings', () => ({
+  nixGlobalSettings: {
+    agentCmdOverrides: {
+      codex: `/bin/sh -c 'exec sandbox-launcher "$@"' orca-sandbox codex`,
+      claude: `/bin/sh -c 'exec sandbox-launcher "$@"' orca-sandbox claude`
+    }
+  }
+}))
+
+const NOT_RUNNABLE = expect.objectContaining({
+  name: 'AgentSessionPreSpawnError',
+  reason: 'agentCommandNotRunnable'
+})
+
+describe('structured agent executable resolution', () => {
+  it.skipIf(process.platform === 'win32')('preserves declared Codex and Claude shell wrapper argv', () => {
+    for (const agent of ['codex', 'claude'] as const) {
+      const command = `/bin/sh -c 'exec sandbox-launcher "$@"' orca-sandbox ${agent}`
+      expect(resolveStructuredAgentCommand(agent, {
+        agentCmdOverrides: { [agent]: command }
+      })).toEqual({
+        command: '/bin/sh',
+        prefixArgs: ['-c', 'exec sandbox-launcher "$@"', 'orca-sandbox', agent]
+      })
+      expect(() => resolveStructuredAgentCommand(agent, {
+        agentCmdOverrides: { [agent]: command + ' ; echo changed' }
+      })).toThrow(NOT_RUNNABLE)
+    }
+  })
+})
