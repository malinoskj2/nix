+html.native-shell.dark .titlebar-left-floating,
+html.native-shell.dark .orca-titlebar-glass {
+  background: rgb(17 17 27 / 55%);
+}
+
+html.native-shell.dark .orca-right-sidebar-surface {
+  background: transparent;
+}
+
+html.native-shell.dark .orca-right-sidebar-activity-bar {
+  background: linear-gradient(to bottom, rgb(17 17 27 / 55%) 36px, var(--sidebar) 36px);
+}
+
 .titlebar-traffic-light-pad {
