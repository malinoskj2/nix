diff --git a/src/renderer/src/assets/main.css b/src/renderer/src/assets/main.css
index 6691e244..b8bc742b 100644
--- a/src/renderer/src/assets/main.css
+++ b/src/renderer/src/assets/main.css
@@ -1002,6 +1002,16 @@ body[data-modal-overlay-open]
   backdrop-filter: none !important;
 }
 
+/* The native Linux window is alpha-capable. Keep only the titlebar band translucent;
+   the base fill below it prevents terminal and page surfaces from becoming glass. */
+html.native-shell.dark body {
+  background: transparent;
+}
+
+html.native-shell.dark .app-layout {
+  background: linear-gradient(to bottom, transparent 36px, var(--background) 36px);
+}
+
 /* Why: native windows have a stable content box and need no wake-time viewport reflow. */
 html.native-shell,
 html.native-shell body,
@@ -1109,6 +1119,21 @@ html.native-shell .app-layout {
   background: var(--bg-titlebar, var(--card));
 }
 
+html.native-shell.dark .titlebar,
+html.native-shell.dark .titlebar-left,
+html.native-shell.dark .titlebar-left-floating,
+html.native-shell.dark .orca-titlebar-glass {
+  background: rgb(17 17 27 / 55%);
+}
+
+html.native-shell.dark .orca-right-sidebar-surface {
+  background: transparent;
+}
+
+html.native-shell.dark .orca-right-sidebar-activity-bar {
+  background: linear-gradient(to bottom, rgb(17 17 27 / 55%) 36px, var(--sidebar) 36px);
+}
+
 .titlebar-traffic-light-pad {
   width: calc(80px / var(--ui-zoom-factor, 1));
   flex-shrink: 0;
