--- a/src/main/plugins/bootstrap/plugin-bundled-bootstrap.ts
+++ b/src/main/plugins/bootstrap/plugin-bundled-bootstrap.ts
@@ -194,6 +194,11 @@
   // Why: a release that drops a bundled plugin must not leave it installed but unremovable.
   const shipped = new Set(index.plugins.map((entry) => entry.pluginKey))
   for (const [pluginKey, locked] of Object.entries(lock.plugins)) {
+    // Legacy Nix bundles must survive until the native CLI can migrate them. Retirement
+    // deletes storage and revokes settings/disable state before a runtime is available.
+    if (pluginKey === 'chron0.discord-presence' || pluginKey === 'etherll.usage-insights') {
+      continue
+    }
     if (locked.source.kind !== 'bundled' || shipped.has(pluginKey)) {
       continue
     }
