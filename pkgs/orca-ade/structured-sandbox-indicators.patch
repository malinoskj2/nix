@@ -0,0 +1,51 @@
+import { useCallback, useEffect, useMemo, useSyncExternalStore } from 'react'
+import { Box } from 'lucide-react'
+import { useAppStore } from '@/store'
+import { structuredChatTabById } from '@/lib/structured-chat-tab-index'
+import {
+  structuredAgentSessionOwnerForTab,
+  structuredAgentSessionTargetForHost
+} from '@/runtime/structured-agent-session-owner'
+import { getStructuredAgentSessionStatusFeed } from '@/runtime/structured-agent-session-status-feed'
+
+/** Read the session's recorded launch, never today's Command setting or permission mode. */
+export function StructuredSessionSandboxBadge({
+  worktreeId,
+  tabId
+}: {
+  worktreeId: string
+  tabId: string
+}): React.JSX.Element | null {
+  const tab = useAppStore((state) =>
+    structuredChatTabById(state.unifiedTabsByWorktree, worktreeId, tabId)
+  )
+  const owner = useAppStore((state) => (tab ? structuredAgentSessionOwnerForTab(state, tab) : null))
+  const sessionId = tab?.entityId
+  const feed = useMemo(() => {
+    const target = structuredAgentSessionTargetForHost(owner)
+    return sessionId && target ? getStructuredAgentSessionStatusFeed(target) : null
+  }, [owner, sessionId])
+  useEffect(() => feed?.activate(), [feed])
+  const subscribe = useCallback(
+    (listener: () => void) =>
+      feed && sessionId ? feed.subscribeSession(sessionId, listener) : () => {},
+    [feed, sessionId]
+  )
+  const sandbox = useSyncExternalStore(
+    subscribe,
+    () => sessionId && feed?.getSnapshot().get(sessionId)?.sandboxLaunch === true,
+    () => false
+  )
+  if (!sandbox) return null
+  return (
+    <span
+      className="mx-1 inline-flex shrink-0 items-center gap-1 text-xs text-muted-foreground"
+      data-session-environment="sandbox"
+      title="This session uses the sandbox launcher"
+      aria-label="Sandbox launch"
+    >
+      <Box className="size-3" aria-hidden />
+      Sandbox
+    </span>
+  )
+}
