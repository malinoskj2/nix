@@ -0,0 +1,18 @@
+import type { GlobalSettings } from '../../shared/global-settings-types'
+import { nixGlobalSettings } from '../../shared/nix-global-settings'
+
+/** Pin launch provenance, independent of agent permissions and the workspace's host. */
+export function nixSandboxLaunchEnvironment(
+  agent: string,
+  settings: Partial<Pick<GlobalSettings, 'agentCmdOverrides'>>
+): Record<string, string> {
+  const declared: Partial<GlobalSettings> = nixGlobalSettings
+  const command = settings.agentCmdOverrides?.[agent]?.trim()
+  const sandbox = Boolean(
+    command &&
+    command === declared.agentCmdOverrides?.[agent]?.trim() &&
+    command.endsWith(` orca-sandbox ${agent}`)
+  )
+  // Explicit false prevents an inherited sandbox variable labelling a host launch.
+  return { ORCA_SANDBOX_LAUNCH: sandbox ? '1' : '0' }
+}
