+// @vitest-environment happy-dom
+import { act, cleanup, render } from '@testing-library/react'
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest'
+
+const fixture = vi.hoisted(() => ({
+  tab: { entityId: 'session-one' } as { entityId: string } | undefined,
+  sandboxLaunch: undefined as boolean | undefined,
+  listeners: new Set<() => void>()
+}))
+vi.mock('@/store', () => ({ useAppStore: (select: (state: unknown) => unknown) => select({}) }))
+vi.mock('@/lib/structured-chat-tab-index', () => ({ structuredChatTabById: () => fixture.tab }))
+vi.mock('@/runtime/structured-agent-session-owner', () => ({
+  structuredAgentSessionOwnerForTab: () => 'local',
+  structuredAgentSessionTargetForHost: () => ({ kind: 'local' })
+}))
+vi.mock('@/runtime/structured-agent-session-status-feed', () => ({
+  getStructuredAgentSessionStatusFeed: () => ({
+    activate: () => () => {},
+    subscribeSession: (_id: string, listener: () => void) => {
+      fixture.listeners.add(listener)
+      return () => fixture.listeners.delete(listener)
+    },
+    getSnapshot: () => new Map([['session-one', { sandboxLaunch: fixture.sandboxLaunch }]])
+  })
+}))
+import { StructuredSessionSandboxBadge } from './StructuredSessionSandboxBadge'
+
+beforeEach(() => {
+  fixture.tab = { entityId: 'session-one' }
+  fixture.sandboxLaunch = undefined
+})
+afterEach(cleanup)
+
+describe('native chat sandbox indicator', () => {
+  it('shows recorded sandbox launches and responds when the owning host changes the launch', () => {
+    const view = render(<StructuredSessionSandboxBadge worktreeId="worktree" tabId="tab" />)
+    expect(view.queryByText('Sandbox')).toBeNull()
+    act(() => {
+      fixture.sandboxLaunch = true
+      fixture.listeners.forEach((listener) => listener())
+    })
+    expect(view.getByText('Sandbox').getAttribute('data-session-environment')).toBe('sandbox')
+    act(() => {
+      fixture.sandboxLaunch = false
+      fixture.listeners.forEach((listener) => listener())
+    })
+    expect(view.queryByText('Sandbox')).toBeNull()
+  })
+
+  it('does not label a terminal or an older session with no launch provenance', () => {
+    fixture.tab = undefined
+    fixture.sandboxLaunch = true
+    const view = render(<StructuredSessionSandboxBadge worktreeId="worktree" tabId="terminal" />)
+    expect(view.queryByText('Sandbox')).toBeNull()
+  })
+})
