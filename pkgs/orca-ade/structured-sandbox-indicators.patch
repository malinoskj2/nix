+import { describe, expect, it, vi } from 'vitest'
+import { nixSandboxLaunchEnvironment } from './nix-sandbox-launch-environment'
+const { command } = vi.hoisted(() => ({
+  command: `/bin/sh -c 'exec sandbox-launcher "$@"' orca-sandbox codex`
+}))
+vi.mock('../../shared/nix-global-settings', () => ({
+  nixGlobalSettings: { agentCmdOverrides: { codex: command } }
+}))
+
+describe('sandbox launch provenance', () => {
+  it('recognises only the exact declared sandbox command', () => {
+    expect(nixSandboxLaunchEnvironment('codex', { agentCmdOverrides: { codex: command } })).toEqual(
+      { ORCA_SANDBOX_LAUNCH: '1' }
+    )
+    for (const override of ['codex', command + ' --other', '']) {
+      expect(
+        nixSandboxLaunchEnvironment('codex', { agentCmdOverrides: { codex: override } })
+      ).toEqual({ ORCA_SANDBOX_LAUNCH: '0' })
+    }
+    expect(nixSandboxLaunchEnvironment('claude', {})).toEqual({ ORCA_SANDBOX_LAUNCH: '0' })
+  })
+})
