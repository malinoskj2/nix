@@ -0,0 +1,84 @@
+import { createContext } from 'react'
+import { Box, Layers } from 'lucide-react'
+import { useShallow } from 'zustand/react/shallow'
+import { useAppStore } from '@/store'
+import { useTerminalContainers } from '@/lib/terminal-container-state'
+import { parsePaneKey } from '../../../shared/workspace-layout/stable-pane-id'
+import { collectLeafIds } from '../../../shared/workspace-layout/terminal-pane-layout-tree'
+import type { AppState } from '@/store/types'
+import { Tooltip, TooltipContent, TooltipTrigger } from '@/components/ui/tooltip'
+
+export const TerminalTabContainerContext = createContext<string | null>(null)
+
+export function paneContainerPty(state: AppState, paneKey: string): string | null {
+  const pane = parsePaneKey(paneKey)
+  if (!pane) {
+    return null
+  }
+  const layout = state.terminalLayoutsByTabId[pane.tabId]
+  if (layout) {
+    const boundPty = layout.ptyIdsByLeafId?.[pane.leafId]
+    if (boundPty) {
+      return boundPty
+    }
+    const leaves = collectLeafIds(layout.root)
+    if (leaves.length !== 1 || leaves[0] !== pane.leafId) {
+      return null
+    }
+  }
+  const ids = state.ptyIdsByTabId[pane.tabId] ?? []
+  return ids.length === 1 ? ids[0]! : null
+}
+
+export function ContainerBadge({
+  names
+}: {
+  names: readonly (string | null)[]
+}): React.JSX.Element | null {
+  const containers = [...new Set(names.filter((name): name is string => name !== null))]
+  if (containers.length === 0) {
+    return null
+  }
+  const mixed = containers.length > 1 || names.some((name) => name === null)
+  const label = `${mixed ? 'Mixed environments. ' : ''}Container: ${containers.join(', ')}${names.includes(null) ? '; other panes: environment not reported' : ''}`
+  const Icon = mixed ? Layers : Box
+  return (
+    <Tooltip>
+      <TooltipTrigger asChild>
+        <span
+          className="inline-flex shrink-0 text-muted-foreground"
+          aria-label={label}
+          data-terminal-container={mixed ? 'mixed' : containers[0]}
+        >
+          <Icon className="size-3" aria-hidden />
+        </span>
+      </TooltipTrigger>
+      <TooltipContent side="top" sideOffset={4}>
+        {label}
+      </TooltipContent>
+    </Tooltip>
+  )
+}
+
+export function PaneContainerBadge({ paneKey }: { paneKey: string }): React.JSX.Element | null {
+  const ptyId = useAppStore((state) => paneContainerPty(state, paneKey))
+  const name = useTerminalContainers((state) =>
+    ptyId ? (state.reports[ptyId]?.name ?? null) : null
+  )
+  return <ContainerBadge names={[name]} />
+}
+
+export function TabContainerBadge({ tabId }: { tabId: string }): React.JSX.Element | null {
+  const ptyIds = useAppStore(
+    useShallow((state) => {
+      const layout = state.terminalLayoutsByTabId[tabId]
+      return layout
+        ? collectLeafIds(layout.root).map((id) => paneContainerPty(state, `${tabId}:${id}`))
+        : (state.ptyIdsByTabId[tabId] ?? [])
+    })
+  )
+  const names = useTerminalContainers(
+    useShallow((state) => ptyIds.map((id) => (id ? (state.reports[id]?.name ?? null) : null)))
+  )
+  return <ContainerBadge names={names} />
+}
