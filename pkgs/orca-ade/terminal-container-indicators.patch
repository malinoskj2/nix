+import { beforeEach, expect, it } from 'vitest'
+import {
+  beginTerminalContainerTracking,
+  forgetTerminalContainer,
+  observeTerminalContainers,
+  useTerminalContainers
+} from './terminal-container-state'
+
+beforeEach(() => {
+  useTerminalContainers.setState({ reports: {} })
+  beginTerminalContainerTracking('first')
+  beginTerminalContainerTracking('second')
+})
+const observe = (ptyId: string, seq: number, name: string | null) =>
+  observeTerminalContainers({ ptyId, seq, facts: [{ kind: 'container', name }] })
+
+it('keeps terminal environments separate and refuses stale replay', () => {
+  observe('first', 4, 'nix')
+  observe('second', 7, 'other')
+  observe('first', 5, null)
+  observe('first', 4, 'nix')
+  expect(useTerminalContainers.getState().reports.first.name).toBeNull()
+  expect(useTerminalContainers.getState().reports.second.name).toBe('other')
+  forgetTerminalContainer('second')
+  expect(useTerminalContainers.getState().reports.second).toBeUndefined()
+})
+
+it('refuses late attach snapshots after exit and accepts a new incarnation', () => {
+  observe('first', 4, 'nix')
+  forgetTerminalContainer('first')
+  observe('first', 5, 'nix')
+  expect(useTerminalContainers.getState().reports.first).toBeUndefined()
+  beginTerminalContainerTracking('first')
+  observe('first', 1, 'fresh')
+  expect(useTerminalContainers.getState().reports.first.name).toBe('fresh')
+})
