+import { describe, expect, it, vi } from 'vitest'
+import { createContainerReportScanner, parseContainerReport } from './terminal-container-report'
+import { createTerminalTitleTracker } from './terminal-output-side-effects'
+
+const report = (name: string) => `\x1b]777;orca-container;name=${name}\x1b\\`
+
+describe('container reports', () => {
+  it('accepts only bounded container names and an explicit clear', () => {
+    expect(parseContainerReport('orca-container;name=agent-sandbox-nix-h12')).toBe(
+      'agent-sandbox-nix-h12'
+    )
+    expect(parseContainerReport('orca-container;clear')).toBeNull()
+    for (const value of ['', '../host', 'a\n', 'a'.repeat(129)]) {
+      expect(parseContainerReport(`orca-container;name=${value}`)).toBeUndefined()
+    }
+  })
+
+  it('handles every possible chunk split, with BEL and ST terminators', () => {
+    for (const sequence of [report('nix'), report('nix').replace('\x1b\\', '\x07')]) {
+      for (let split = 0; split <= sequence.length; split++) {
+        const observed = vi.fn()
+        const scan = createContainerReportScanner(observed)
+        scan(sequence.slice(0, split))
+        scan(sequence.slice(split))
+        expect(observed.mock.calls).toEqual([['nix']])
+      }
+    }
+  })
+
+  it('ignores reports inside other terminal strings and recovers from oversized input', () => {
+    const observed = vi.fn()
+    const scan = createContainerReportScanner(observed)
+    scan(`\x1b]0;${report('spoof')}`)
+    scan(`\x1bP${report('spoof')}`)
+    scan(`\x1b]777;${'x'.repeat(10000)}\x07`)
+    scan(report('real'))
+    expect(observed.mock.calls).toEqual([['real']])
+  })
+
+  it('keeps independent PTYs, preserves reports through title changes, and clears on exit reports', () => {
+    const first = createTerminalTitleTracker({})
+    const second = createTerminalTitleTracker({})
+    first.handleChunk(report('nix'))
+    second.handleChunk(report('other'))
+    first.handleChunk('\x1b]0;Claude Code\x07')
+    expect(first.getContainerName()).toBe('nix')
+    first.handleChunk('\x1b]777;orca-container;clear\x1b\\')
+    expect(first.getContainerName()).toBeNull()
+    expect(second.getContainerName()).toBe('other')
+    first.dispose()
+    second.dispose()
+  })
+
+  it('accepts daemon reports while skipping thinned bytes and resets scanner carry at handoff', () => {
+    const tracker = createTerminalTitleTracker({})
+    tracker.handleChunk(report('partial').slice(0, 10))
+    tracker.setTransientFactScanningSuppressed(true)
+    tracker.handleChunk(report('untrusted-gap'))
+    expect(tracker.getContainerName()).toBeUndefined()
+    tracker.reportContainerName('daemon')
+    tracker.setTransientFactScanningSuppressed(false)
+    tracker.handleChunk(report('partial').slice(10))
+    expect(tracker.getContainerName()).toBe('daemon')
+    tracker.handleChunk(report('foreground'))
+    expect(tracker.getContainerName()).toBe('foreground')
+    tracker.dispose()
+  })
+})
