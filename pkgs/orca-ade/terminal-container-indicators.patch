@@ -0,0 +1,47 @@
+import { create } from 'zustand'
+import type { TerminalSideEffectBatch } from '../../../shared/terminal/output/terminal-side-effect-facts'
+
+const exitedPtys = new Set<string>()
+
+type Report = { name: string | null; seq: number }
+export const useTerminalContainers = create<{ reports: Record<string, Report> }>(() => ({
+  reports: {}
+}))
+
+export function observeTerminalContainers(batch: TerminalSideEffectBatch): void {
+  if (exitedPtys.has(batch.ptyId)) {
+    return
+  }
+  for (const fact of batch.facts) {
+    if (fact.kind !== 'container') {
+      continue
+    }
+    useTerminalContainers.setState((state) => {
+      const previous = state.reports[batch.ptyId]
+      if (previous && batch.seq < previous.seq) {
+        return state
+      }
+      return { reports: { ...state.reports, [batch.ptyId]: { name: fact.name, seq: batch.seq } } }
+    })
+  }
+}
+
+export function beginTerminalContainerTracking(ptyId: string): void {
+  exitedPtys.delete(ptyId)
+}
+
+export function forgetTerminalContainer(ptyId: string): void {
+  // Bound tombstones while refusing late replay after exit; new PTY incarnations reopen on spawn.
+  exitedPtys.add(ptyId)
+  if (exitedPtys.size > 1024) {
+    exitedPtys.delete(exitedPtys.values().next().value!)
+  }
+  useTerminalContainers.setState((state) => {
+    if (!(ptyId in state.reports)) {
+      return state
+    }
+    const reports = { ...state.reports }
+    delete reports[ptyId]
+    return { reports }
+  })
+}
