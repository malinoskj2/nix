+import { beforeEach, describe, expect, it, vi } from 'vitest'
+import { renderToStaticMarkup } from 'react-dom/server'
+import { TooltipProvider } from './ui/tooltip'
+import type * as ContainerState from '@/lib/terminal-container-state'
+import { useTerminalContainers } from '@/lib/terminal-container-state'
+
+vi.mock('@/lib/terminal-container-state', async (importOriginal) => {
+  const original = await importOriginal<typeof ContainerState>()
+  return {
+    ...original,
+    useTerminalContainers: Object.assign(
+      (selector: (state: ReturnType<typeof original.useTerminalContainers.getState>) => unknown) =>
+        selector(original.useTerminalContainers.getState()),
+      original.useTerminalContainers
+    )
+  }
+})
+
+const fixture = vi.hoisted(() => ({ state: {} as Record<string, unknown> }))
+vi.mock('@/store', () => ({
+  useAppStore: (selector: (state: unknown) => unknown) => selector(fixture.state)
+}))
+import { PaneContainerBadge, TabContainerBadge } from './TerminalContainerBadge'
+
+const first = '11111111-1111-4111-8111-111111111111'
+const second = '22222222-2222-4222-8222-222222222222'
+const render = (element: React.ReactNode) =>
+  renderToStaticMarkup(<TooltipProvider>{element}</TooltipProvider>)
+
+beforeEach(() => {
+  fixture.state = {
+    terminalLayoutsByTabId: {
+      tab: {
+        root: {
+          type: 'split',
+          direction: 'horizontal',
+          first: { type: 'leaf', leafId: first },
+          second: { type: 'leaf', leafId: second }
+        },
+        ptyIdsByLeafId: { [first]: 'pty-1', [second]: 'pty-2' }
+      }
+    },
+    ptyIdsByTabId: { tab: ['pty-1', 'pty-2'] }
+  }
+  useTerminalContainers.setState({ reports: { 'pty-1': { seq: 1, name: 'nix' } } })
+})
+
+describe('terminal container badges', () => {
+  it('marks only the reporting pane, even when another pane shares its tab', () => {
+    expect(render(<PaneContainerBadge paneKey={`tab:${first}`} />)).toContain('Container: nix')
+    expect(render(<PaneContainerBadge paneKey={`tab:${second}`} />)).toBe('')
+  })
+  it('uses the sole mounted PTY while a single-pane binding is being restored', () => {
+    fixture.state = {
+      terminalLayoutsByTabId: { tab: { root: { type: 'leaf', leafId: first } } },
+      ptyIdsByTabId: { tab: ['pty-1'] }
+    }
+    expect(render(<PaneContainerBadge paneKey={`tab:${first}`} />)).toContain('Container: nix')
+    expect(render(<TabContainerBadge tabId="tab" />)).toContain('Container: nix')
+    expect(render(<PaneContainerBadge paneKey={`tab:${second}`} />)).toBe('')
+  })
+  it('marks a split tab as mixed when another pane has no report', () => {
+    expect(render(<TabContainerBadge tabId="tab" />)).toContain('data-terminal-container="mixed"')
+    expect(render(<TabContainerBadge tabId="tab" />)).toContain('environment not reported')
+  })
+  it('shows both container names when the split panes differ', () => {
+    useTerminalContainers.setState({
+      reports: { 'pty-1': { seq: 1, name: 'nix' }, 'pty-2': { seq: 1, name: 'other' } }
+    })
+    expect(render(<TabContainerBadge tabId="tab" />)).toContain('Container: nix, other')
+  })
+  it('does not call an unreported terminal a host', () => {
+    useTerminalContainers.setState({ reports: {} })
+    expect(render(<TabContainerBadge tabId="tab" />)).toBe('')
+  })
+})
