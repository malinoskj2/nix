@@ -0,0 +1,81 @@
+/** Launcher reports describe a container, never the agent's permission policy. */
+export const CONTAINER_REPORT_OSC = 777
+const PREFIX = 'orca-container;'
+const MAX_BODY = 160
+
+export function parseContainerReport(body: string): string | null | undefined {
+  if (body === `${PREFIX}clear`) {
+    return null
+  }
+  if (!body.startsWith(`${PREFIX}name=`)) {
+    return undefined
+  }
+  const name = body.slice(`${PREFIX}name=`.length)
+  return /^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$/.test(name) ? name : undefined
+}
+
+/** Bounded string scanner; never interpret a report embedded inside another control string. */
+export function createContainerReportScanner(report: (name: string | null) => void) {
+  let state: 'text' | 'escape' | 'string' | 'string-escape' = 'text'
+  let body = ''
+  let osc = false
+  let overflow = false
+  const finish = () => {
+    if (osc && !overflow && body.startsWith(`${CONTAINER_REPORT_OSC};`)) {
+      const name = parseContainerReport(body.slice(4))
+      if (name !== undefined) {
+        report(name)
+      }
+    }
+    state = 'text'
+    body = ''
+  }
+  return (data: string): void => {
+    for (let index = 0; index < data.length; index++) {
+      if (state === 'text') {
+        index = data.indexOf('\x1b', index)
+        if (index === -1) {
+          return
+        }
+      }
+      const char = data[index]
+      if (char === '\x18' || char === '\x1a') {
+        state = 'text'
+        body = ''
+        continue
+      }
+      if (state === 'text') {
+        if (char === '\x1b') {
+          state = 'escape'
+        }
+      } else if (state === 'escape') {
+        if (']PX^_'.includes(char)) {
+          state = 'string'
+          osc = char === ']'
+          body = ''
+          overflow = false
+        } else {
+          state = char === '\x1b' ? 'escape' : 'text'
+        }
+      } else if (state === 'string-escape') {
+        if (char === '\\') {
+          finish()
+        } else {
+          overflow = true
+          state = char === '\x1b' ? 'string-escape' : 'string'
+        }
+      } else if (char === '\x07') {
+        finish()
+      } else if (char === '\x1b') {
+        state = 'string-escape'
+      } else if (!overflow && osc) {
+        if (body.length < MAX_BODY) {
+          body += char
+        } else {
+          overflow = true
+          body = ''
+        }
+      }
+    }
+  }
+}
