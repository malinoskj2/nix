+          agentCmdOverrides: { claude: `${process.execPath} orca-sandbox claude` }
+        }),
+        options
+      )
+  )
+  const sources = await resolveClaudeChildEnvSources({
+    location,
+    resolveCommand,
+    resolveInheritedEnv: async () => ({ PATH: '/bin' })
+  })
+  expect(resolveCommand.mock.calls[0]?.[0]?.location).toEqual(location)
+  expect(sources.command).toBe(process.execPath)
+  expect(sources.prefixArgs).toEqual([])
+})
