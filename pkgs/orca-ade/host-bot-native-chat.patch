+import { expect, it, vi } from 'vitest'
+import { nixBotCommandSettings } from '../../../native-chat/nix-bot-command-settings'
+import { nixSandboxLaunchEnvironment } from '../../../native-chat/nix-sandbox-launch-environment'
+import { resolveStructuredAgentCommand } from '../../../native-chat/agent-launch/structured-agent-command-resolution'
+import { agentSessionRecordFixture } from '../../../../shared/agent-session/lifecycle/records/agent-session-record.test-fixture'
+import type { AgentSessionRecord } from '../../../../shared/agent-session/lifecycle/agent-session-record'
+import { identityFor } from '../../../codex/structured/session-lifecycle/codex-structured-session-adapter-fixture'
+import { pinnedAgentSessionLaunchEnv } from '../../../native-chat/agent-session-wire/acquisition/structured-agent-session-launch-env'
+import { resolveClaudeChildEnvSources } from '../../../claude/structured/launch/claude-structured-child-env'
+import {
+  createCodexStructuredLaunchResolver,
+  TEST_SPAWN_TOKEN
+} from './structured-agent-launch-composition.test-support'
+
+const { sandbox, settings, bots } = vi.hoisted(() => {
+  const sandbox = `${process.execPath} orca-sandbox codex`
+  return {
+    sandbox,
+    settings: { agentCmdOverrides: { codex: sandbox } },
+    bots: [{ id: 'tohru', hostId: 'local', folderWorkspaceId: 'home' }] as const
+  }
+})
+vi.mock('../../../../shared/nix-host-bots', () => ({
+  nixHostBotCommands: { tohru: { codex: process.execPath, claude: process.execPath } }
+}))
+vi.mock('../../../../shared/nix-global-settings', () => ({ nixGlobalSettings: settings }))
+
+it.each(['folder:home', 'tohru-created-project'])(
+  'uses target location for actual command and provenance: %s',
+  async (workspaceId) => {
+    const home = workspaceId === 'folder:home'
+    const record: AgentSessionRecord = {
+      ...agentSessionRecordFixture(),
+      provider: 'codex',
+      providerHandleChain: [],
+      location: {
+        executionHostId: 'local',
+        wslDistro: null,
+        workspaceId,
+        workspaceKind: home ? 'folder' : 'git-worktree'
+      },
+      accountHome: { variable: 'CODEX_HOME', path: '/selected/account' }
+    }
+    const resolveLaunchEnv = (agent: string, location?: AgentSessionRecord['location']) =>
+      nixSandboxLaunchEnvironment(agent, nixBotCommandSettings(agent, location, bots, settings))
+    const resolveCommand = vi.fn(
+      (options?: {
+        pathEnv?: string | null
+        homePath?: string
+        location?: AgentSessionRecord['location']
+      }) =>
+        resolveStructuredAgentCommand(
+          'codex',
+          nixBotCommandSettings('codex', options?.location, bots, settings),
+          options
+        )
+    )
+    const resolve = createCodexStructuredLaunchResolver({
+      store: { getRecord: () => record, pinLaunchDirectory: vi.fn() },
+      resolveCommand,
+      resolveEnvironment: async () => ({ ORCA_SANDBOX_LAUNCH: '1' }),
+      resolveLaunchEnv,
+      resolveLaunchArgs: () => [],
+      // Same cwd in both cases proves the policy does not grant host access based on directory text.
+      resolveWorkspacePath: async () => '/home/jesse/.orca/bots/tohru'
+    })
+    for (let start = 0; start < 2; start++) {
+      const launch = await resolve({
+        identity: identityFor(record.sessionId),
+        spawnToken: TEST_SPAWN_TOKEN
+      })
+      expect(launch.command).toBe(process.execPath)
+      expect(launch.prefixArgs).toEqual(home ? [] : ['orca-sandbox', 'codex'])
+      expect(launch.env.ORCA_SANDBOX_LAUNCH).toBe(home ? '0' : '1')
+      expect(launch.env.CODEX_HOME).toBe('/selected/account')
+      expect(launch.env.ORCA_AGENT_SESSION_ID).toBe(record.sessionId)
+      expect(launch.cwd).toBe('/home/jesse/.orca/bots/tohru')
+    }
+    expect(resolveCommand.mock.calls[0]?.[0]?.location).toEqual(record.location)
+    const pinned = await pinnedAgentSessionLaunchEnv(resolveLaunchEnv, {
+      provider: 'codex',
+      agent: 'codex',
+      runtimeKind: 'native',
+      location: record.location,
+      accountHome: record.accountHome,
+      envelope: {
+        sessionId: record.sessionId,
+        clientOperationId: 'operation',
+        expectedRuntimeFence: null,
+        payloadFingerprint: ''
+      }
+    })
+    expect(pinned.launchEnv?.ORCA_SANDBOX_LAUNCH).toBe(home ? '0' : '1')
+    expect(settings.agentCmdOverrides.codex).toBe(sandbox)
+  }
+)
+
+it('gives the Claude command resolver the session location', async () => {
+  const location: AgentSessionRecord['location'] = {
+    executionHostId: 'local',
+    wslDistro: null,
+    workspaceId: 'folder:home',
