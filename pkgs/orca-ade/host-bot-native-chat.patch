@@ -0,0 +1,60 @@
+import { expect, it, vi } from 'vitest'
+import { nixBotCommandSettings } from './nix-bot-command-settings'
+import type { AgentSessionExecutionLocation } from '../../shared/agent-session/lifecycle/agent-session-record'
+
+vi.mock('../../shared/nix-host-bots', () => ({
+  nixHostBotCommands: { tohru: { codex: '/host/codex', claude: '/host/claude' } }
+}))
+
+const bots = [{ id: 'tohru', hostId: 'local', folderWorkspaceId: 'tohru-home' }] as const
+const location: AgentSessionExecutionLocation = {
+  executionHostId: 'local',
+  wslDistro: null,
+  workspaceKind: 'folder',
+  workspaceId: 'folder:tohru-home'
+}
+const settings = { agentCmdOverrides: { codex: '/sandbox codex', claude: '/sandbox claude' } }
+
+it('selects the registered bot home independently of its name and without changing settings', () => {
+  expect(nixBotCommandSettings('codex', location, bots, settings, 'linux')).toEqual({
+    agentCmdOverrides: { codex: '/host/codex', claude: '/sandbox claude' }
+  })
+  expect(nixBotCommandSettings('claude', location, bots, settings, 'linux')).toEqual({
+    agentCmdOverrides: { codex: '/sandbox codex', claude: '/host/claude' }
+  })
+  expect(settings.agentCmdOverrides.codex).toBe('/sandbox codex')
+  expect(settings.agentCmdOverrides.claude).toBe('/sandbox claude')
+})
+
+it.each([
+  { ...location, workspaceId: 'project-child' },
+  { ...location, workspaceKind: 'git-worktree' },
+  { ...location, executionHostId: 'ssh:host' },
+  { ...location, wslDistro: 'Ubuntu' },
+  { ...location, workspaceId: 'folder:other-bot' }
+] satisfies AgentSessionExecutionLocation[])(
+  'keeps the default outside the exact local folder: %j',
+  (target) => {
+    expect(nixBotCommandSettings('codex', target, bots, settings, 'linux')).toBe(settings)
+    expect(nixBotCommandSettings('claude', target, bots, settings, 'linux')).toBe(settings)
+  }
+)
+
+it('keeps defaults for other providers, platforms, missing bots and catalog requests', () => {
+  expect(nixBotCommandSettings('antigravity', location, bots, settings, 'linux')).toBe(settings)
+  expect(nixBotCommandSettings('codex', location, bots, settings, 'darwin')).toBe(settings)
+  expect(nixBotCommandSettings('codex', location, [], settings, 'linux')).toBe(settings)
+  expect(nixBotCommandSettings('codex', undefined, bots, settings, 'linux')).toBe(settings)
+  expect(
+    nixBotCommandSettings(
+      'codex',
+      location,
+      [{ ...bots[0], id: 'recreated-bot' }],
+      settings,
+      'linux'
+    )
+  ).toBe(settings)
+  expect(
+    nixBotCommandSettings('codex', location, [{ ...bots[0], id: 'toString' }], settings, 'linux')
+  ).toBe(settings)
+})
