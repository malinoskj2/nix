--- /dev/null
+++ b/src/main/native-chat/nix-bot-command-settings.ts
@@ -0,0 +1,33 @@
+import type { Bot } from '../../shared/bot-types'
+import { botOfHomeWorkspace } from '../../shared/bots/bot-homes'
+import type { AgentSessionExecutionLocation } from '../../shared/agent-session/lifecycle/agent-session-record'
+import { isNativeLocalLocation } from '../../shared/execution-host/execution-host'
+import type { GlobalSettings } from '../../shared/settings/global-settings-types'
+import { nixHostBotCommands } from '../../shared/nix-host-bots'
+
+/** Only registered bot homes select a host command; project launches never inherit it. */
+export function nixBotCommandSettings<T extends Partial<Pick<GlobalSettings, 'agentCmdOverrides'>>>(
+  agent: string,
+  location: AgentSessionExecutionLocation | undefined,
+  bots: readonly Pick<Bot, 'id' | 'hostId' | 'folderWorkspaceId'>[],
+  settings: T,
+  platform: string = process.platform
+): T {
+  if (
+    platform !== 'linux' ||
+    (agent !== 'codex' && agent !== 'claude') ||
+    !location ||
+    location.workspaceKind !== 'folder' ||
+    !isNativeLocalLocation(location)
+  ) {
+    return settings
+  }
+  const bot = botOfHomeWorkspace(bots, location.workspaceId)
+  const command =
+    bot?.hostId === 'local' && Object.hasOwn(nixHostBotCommands, bot.id)
+      ? nixHostBotCommands[bot.id]?.[agent]
+      : undefined
+  return command
+    ? { ...settings, agentCmdOverrides: { ...settings.agentCmdOverrides, [agent]: command } }
+    : settings
+}
