diff --git a/src/main/bots/desktop-bot-auto-steer.test.ts b/src/main/bots/desktop-bot-auto-steer.test.ts
new file mode 100644
index 0000000..a3b0a2a
--- /dev/null
+++ b/src/main/bots/desktop-bot-auto-steer.test.ts
@@ -0,0 +1,96 @@
+import { afterEach, expect, it } from 'vitest'
+import { botChatSessions } from './bot-chat-session'
+import { makeTestBot } from './bot.test-fixture'
+import { currentDesktopOwnerOrigin } from './desktop-voice-continuations'
+import {
+  createQueuedMessageTestRig,
+  type QueuedMessageTestRig
+} from '../native-chat/agent-session-wire/host/testing/structured-agent-session-queued-message-rig.test-fixture'
+import { openRigTurnFor } from '../native-chat/agent-session-wire/host/testing/structured-agent-session-queued-rig-turn.test-fixture'
+import {
+  HOST_TEST_SESSION as SESSION,
+  HOST_TEST_THREAD as THREAD,
+  hostTestOperationId
+} from '../native-chat/agent-session-wire/host/testing/structured-agent-session-host-test-data.test-fixture'
+import { eventually } from '../native-chat/agent-session-wire/host/testing/structured-agent-session-queued-message-rig-provider.test-fixture'
+import { agentJournalSubmissionKey } from '../../shared/agent-session/journal/agent-session-journal-item-key'
+import { readAgentJournalPage } from '../native-chat/agent-session-wire/publication/history/agent-read-journal-page'
+
+let rig: QueuedMessageTestRig | undefined
+afterEach(async () => {
+  await rig?.dispose()
+  rig = undefined
+})
+it('steers a desktop voice owner message into running Home and preserves its canonical request alias', async () => {
+  rig = await createQueuedMessageTestRig({ restartable: true })
+  const current = rig
+  const opener = await current.workingSend()
+  await current.settleAccepted(opener, 'opening')
+  await openRigTurnFor(current, opener)
+  const bot = makeTestBot({ id: 'tohru', chatSessionId: SESSION })
+  const chats = botChatSessions({
+    bots: { list: () => [bot], setChatSession: async () => bot },
+    host: async () => current.host,
+    createChat: async () => {
+      throw new Error('must not create a chat')
+    },
+    showTab: async () => {},
+    closeChat: async () => {
+      throw new Error('must not close Home')
+    }
+  })
+  const earlier = current.send('an older unsteered draft', 'queue-if-active')
+  await earlier.result
+  const operation = hostTestOperationId()
+  const delivered = await chats.sendToSession(
+    bot.id,
+    SESSION,
+    '[tohru-desktop:voice]\nHow is it going?',
+    undefined,
+    undefined,
+    operation,
+    'now'
+  )
+  if (delivered.outcome.kind === 'refused') throw new Error(delivered.outcome.refusal.message)
+  expect(delivered.outcome.clientMessageId).toBe(operation)
+  await eventually(async () =>
+    expect((await current.handoff(operation))?.handedOverAt).toBeDefined()
+  )
+  expect(await current.handoff(earlier.id)).toBeUndefined()
+  const handoff = await current.handoff(operation)
+  if (!handoff) throw new Error('Expected native handover')
+  await current.settleAccepted(handoff.clientMessageId, 'steered-owner')
+  const { journal } = await current.host.conversation(SESSION)
+  const request = agentJournalSubmissionKey(operation)
+  expect(await currentDesktopOwnerOrigin(journal.reads, SESSION)).toEqual({
+    chat: SESSION,
+    request
+  })
+  const turn = (await current.host.currentWorkAtRest(SESSION))?.activeTurn()
+  if (!turn) throw new Error('Home turn must still be running')
+  await journal.appendItem(
+    { provider: 'codex', threadId: THREAD, turnId: 'steered-answer', ordinal: 0 },
+    {
+      kind: 'message',
+      role: 'assistant',
+      blocks: [{ type: 'text', text: 'The worker is still building.' }]
+    },
+    {
+      fence: current.store.requireWritableRecord(SESSION).lease.runtimeFence,
+      turnScope: { kind: 'turn', turnItemId: turn.item.itemId }
+    }
+  )
+  await openRigTurnFor(current, opener, 'completed', 'success')
+  const page = await readAgentJournalPage(
+    journal,
+    { sessionId: SESSION, limit: 100, includeIds: true },
+    () => false
+  )
+  expect(
+    page.entries.find(
+      (entry) => entry.kind === 'message' && entry.text === 'The worker is still building.'
+    )
+  ).toMatchObject({
+    interaction: { kind: 'answer', requestId: request, completionId: expect.any(String) }
+  })
+})
