+import { execFile } from 'node:child_process'
+import { promisify } from 'node:util'
+import type { AgentJournalRenderItem } from '../../shared/agent-session/journal/agent-session-journal-types'
+import { orchestrationMailNotice } from '../../shared/agent-session/journal/agent-session-message-source'
+import { agentJournalTurnOpener } from '../../shared/agent-session/journal/agent-session-journal-turn-opener'
+import type { TurnEndedRows } from '../native-chat/agent-session-wire/structured-agent-session-turn-context'
+import type { OrcaRuntimeService } from '../runtime/orca-runtime'
+import { readMessageSenderDispatch } from '../runtime/orchestration/db/messages/message-sender-dispatch'
+import { requireStructuredHost } from './bot-chat-session'
+import { readAgentJournalTurnOutcome } from '../../shared/agent-session/lifecycle/records/agent-session-turn-record'
+import { isQuietBotResult } from '../../shared/bot-quiet-result'
+
+type Origin = { chat: string; request: string }
+const MAX_LINKS = 512
+const MAX_AGE = 24 * 60 * 60 * 1000
+
+/** Voice belongs to a particular owner prompt, never merely to the bot or its latest chat. */
+export class DesktopVoiceContinuations {
+  private readonly dispatches = new Map<string, { origin: Origin; at: number; epoch: number }>()
+  private readonly owners = new Map<string, number>()
+  private readonly delivered = new Set<string>()
+
+  remember(dispatch: string, origin: Origin | null, now = Date.now()): void {
+    for (const [id, link] of this.dispatches) {
+      if (now - link.at > MAX_AGE) this.dispatches.delete(id)
+    }
+    if (origin) this.dispatches.set(dispatch, { origin, at: now, epoch: this.owners.get(origin.chat) ?? 0 })
+    else this.dispatches.delete(dispatch)
+    while (this.dispatches.size > MAX_LINKS) {
+      const first = this.dispatches.keys().next().value
+      if (first === undefined) break
+      this.dispatches.delete(first)
+    }
+  }
+
+  ownerTurn(chat: string): void {
+    this.owners.set(chat, (this.owners.get(chat) ?? 0) + 1)
+    while (this.owners.size > MAX_LINKS) {
+      const first = this.owners.keys().next().value
+      if (first === undefined) break
+      this.owners.delete(first)
+    }
+  }
+
+  origin(chat: string, prompt: AgentJournalRenderItem, worker: (message: string) => string | null): Origin | null {
+    const body = prompt.body
+    if (body.kind !== 'message' || body.role !== 'user' || body.origin || body.memorySource) return null
+    if (!body.from) {
+      const text = body.blocks.filter((block) => block.type === 'text').map((block) => block.text).join('\n')
+      return text.startsWith('[tohru-desktop:voice]\n') ? { chat, request: prompt.itemId } : null
+    }
+    const mail = orchestrationMailNotice(body.from)
+    if (!mail?.messages.length) return null
+    let found: Origin | null = null
+    for (const message of mail.messages) {
+      const dispatch = worker(message.messageId)
+      const link = dispatch ? this.dispatches.get(dispatch) : undefined
+      if (!link || Date.now() - link.at > MAX_AGE || link.origin.chat !== chat || link.epoch !== (this.owners.get(chat) ?? 0)) return null
+      if (found && found.request !== link.origin.request) return null
+      found = link.origin
+    }
+    return found
+  }
+
+  claim(completion: string): boolean {
+    if (this.delivered.has(completion)) return false
+    this.delivered.add(completion)
+    while (this.delivered.size > MAX_LINKS) {
+      const first = this.delivered.values().next().value
+      if (first === undefined) break
+      this.delivered.delete(first)
+    }
+    return true
+  }
+}
+
+// A restart deliberately drops speech eligibility; the durable result remains in Orca.
+const continuations = new DesktopVoiceContinuations()
+const run = promisify(execFile)
+
+export function desktopVoiceOwnerTurn(chat: string): void { continuations.ownerTurn(chat) }
+
+function workerOf(runtime: Pick<OrcaRuntimeService, 'getOrchestrationDb'>, message: string): string | null {
+  const db = runtime.getOrchestrationDb()
+  if (db.getMessageById(message)?.type !== 'worker_done') return null
+  return readMessageSenderDispatch(db, message)?.dispatchId ?? null
+}
+
+export async function rememberDesktopVoiceDispatch(runtime: OrcaRuntimeService, dispatchId: string, sender?: string): Promise<void> {
+  const dispatch = runtime.getOrchestrationDb().getDispatchContextById(dispatchId)
+  const chat = dispatch?.creator_orca_session_id
+  if (!chat || (sender !== undefined && sender !== chat)) return
+  const reads = await (await requireStructuredHost(runtime)).journalReads(chat)
+  const prompt = await reads.promptItem('last')
+  continuations.remember(dispatchId, prompt ? continuations.origin(chat, prompt, (id) => workerOf(runtime, id)) : null)
+}
+
+export function desktopVoiceSummary(links: DesktopVoiceContinuations, chat: string, turnId: string,
+  rows: TurnEndedRows, worker: (message: string) => string | null): { origin: Origin; completion: string; text: string } | null {
+  const turn = rows.items.findLast((item) => item.body.kind === 'turn' && item.body.turnId === turnId)
+  if (!turn || turn.body.kind !== 'turn' || !turn.body.userItemId || turn.body.state !== 'completed' || readAgentJournalTurnOutcome(turn.body) !== 'success') return null
+  const prompt = agentJournalTurnOpener(rows, turn.body.userItemId)
+  // Direct replies already return through the desktop request; only analyzed worker follow-ups use this path.
+  if (!prompt || prompt.body.kind !== 'message' || !prompt.body.from) return null
+  const origin = links.origin(chat, prompt, worker)
+  if (!origin) return null
+  const reply = rows.items.findLast((item) => item.turnScope?.kind === 'turn' && item.turnScope.turnItemId === turn.itemId && item.body.kind === 'message' && item.body.role === 'assistant')
+  if (!reply || reply.body.kind !== 'message') return null
+  const text = reply.body.blocks.filter((block) => block.type === 'text').map((block) => block.text).join('\n').trim()
+  return text && text.length <= 16384 && !isQuietBotResult(text) ? { origin, completion: turn.itemId, text } : null
+}
+
+export async function deliverDesktopVoiceContinuation(runtime: OrcaRuntimeService, chat: string, turnId: string, rows: TurnEndedRows): Promise<void> {
+  const summary = desktopVoiceSummary(continuations, chat, turnId, rows, (id) => workerOf(runtime, id))
+  if (!summary || !continuations.claim(summary.completion)) return
+  await run(process.env.ORCA_DESKTOP_ASSISTANT_COMMAND ?? 'tohru', ['assistant', 'voice-result', '--chat', summary.origin.chat, '--request', summary.origin.request, '--completion', summary.completion, '--', summary.text.replace(/[\r\n\t]+/g, ' ')], { timeout: 5000, maxBuffer: 4096 })
+}
