+      ...prompt(text), itemId: text, turnScope: { kind: 'turn', turnItemId },
+      body: { kind: 'message', role: 'assistant', blocks: [{ type: 'text', text }] }
+    })
+    const turn: AgentJournalRenderItem = { ...prompt(''), itemId: 'turn',
+      body: { kind: 'turn', turnId: 'provider-turn', userItemId: 'request', state: 'completed', outcome: 'success' } }
+    const rows: TurnEndedRows = { items: [mail('done'), turn, response('Checking the worker report'), response('My analyzed answer'), response('Another turn', 'other')], openerIds: new Map() }
+    expect(desktopVoiceSummary(links, 'chat', 'provider-turn', rows, () => 'worker')).toEqual({
+      origin: { chat: 'chat', request: 'spoken-request' }, completion: 'turn', text: 'My analyzed answer'
+    })
+    expect(desktopVoiceSummary(links, 'other-chat', 'provider-turn', rows, () => 'worker')).toBeNull()
+    const failed: TurnEndedRows = { ...rows, items: [mail('done'), { ...turn, body: { kind: 'turn', turnId: 'provider-turn', userItemId: 'request', state: 'completed', outcome: 'failure' } }, response('Failed output')] }
+    expect(desktopVoiceSummary(links, 'chat', 'provider-turn', failed, () => 'worker')).toBeNull()
+    expect(desktopVoiceSummary(links, 'chat', 'provider-turn', { ...rows, items: [mail('done'), turn, response('NO_REPLY')] }, () => 'worker')).toBeNull()
+    const direct = { ...rows, items: [prompt('[tohru-desktop:voice]\nQuestion'), turn, response('Direct answer')] }
+    expect(desktopVoiceSummary(links, 'chat', 'provider-turn', direct, () => 'worker')).toBeNull()
+  })
+})
