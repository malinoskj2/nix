+
+function prompt(text: string, request = 'request'): AgentJournalRenderItem {
+  return { itemId: request, sequence: 1, revision: 1, observedAt: 1, turnScope: { kind: 'thread' },
+    body: { kind: 'message', role: 'user', blocks: [{ type: 'text', text }] } }
+}
+function mail(...messages: string[]): AgentJournalRenderItem {
+  return { ...prompt('raw worker report'), body: { kind: 'message', role: 'user', blocks: [{ type: 'text', text: 'raw worker report' }],
+    from: { kind: 'agent', senders: [], orchestration: { message: 'mail-notice', mailbox: 'chat', dispatchId: null,
+      messages: messages.map((messageId) => ({ messageId, runId: 'run', from: 'dispatch:worker' })) } } } }
+}
+
+describe('voice continuation provenance', () => {
+  it('links worker completion and further delegation to the exact spoken request', () => {
+    const links = new DesktopVoiceContinuations()
+    const origin = links.origin('chat', prompt('[tohru-desktop:voice]\nAnalyze this'), () => null)
+    links.remember('worker', origin)
+    const inherited = links.origin('chat', mail('done'), () => 'worker')
+    expect(inherited).toEqual({ chat: 'chat', request: 'request' })
+    links.remember('next-worker', inherited)
+    expect(links.origin('chat', mail('next-done'), () => 'next-worker')).toEqual(origin)
+  })
+  it('does not link text, unrelated or cross-chat mail, or mixed origins', () => {
+    const links = new DesktopVoiceContinuations()
+    expect(links.origin('chat', prompt('[tohru-desktop]\nAnalyze this'), () => null)).toBeNull()
+    links.remember('a', { chat: 'chat', request: 'voice-a' })
+    links.remember('b', { chat: 'chat', request: 'voice-b' })
+    expect(links.origin('other-chat', mail('a'), () => 'a')).toBeNull()
+    expect(links.origin('chat', mail('unknown'), () => null)).toBeNull()
+    expect(links.origin('chat', mail('a', 'b'), (id) => id)).toBeNull()
+  })
+  it('retires old speech eligibility when another owner turn starts', () => {
+    const links = new DesktopVoiceContinuations()
+    links.remember('worker', { chat: 'chat', request: 'voice-a' })
+    links.ownerTurn('chat')
+    expect(links.origin('chat', mail('done'), () => 'worker')).toBeNull()
+    links.remember('worker', { chat: 'chat', request: 'new-spoken-request' })
+    expect(links.origin('chat', mail('done'), () => 'worker')).toEqual({ chat: 'chat', request: 'new-spoken-request' })
+  })
+  it('claims a completed summary once and bounds dispatch storage', () => {
+    const links = new DesktopVoiceContinuations()
+    expect(links.claim('final')).toBe(true)
+    expect(links.claim('final')).toBe(false)
+    for (let i = 0; i < 513; i++) links.remember(String(i), { chat: 'chat', request: String(i) })
+    expect(links.origin('chat', mail('old'), () => '0')).toBeNull()
+    expect(links.origin('chat', mail('new'), () => '512')).toEqual({ chat: 'chat', request: '512' })
+  })
+  it('returns only the successful coordinating turn final, never raw mail or commentary', () => {
+    const links = new DesktopVoiceContinuations()
+    links.remember('worker', { chat: 'chat', request: 'spoken-request' })
