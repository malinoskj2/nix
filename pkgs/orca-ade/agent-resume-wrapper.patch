+const WRAPPED_RESUME_AGENTS: ReadonlySet<TuiAgent> = new Set(['claude', 'codex', 'muse'])
+
+/** Local resumes of these agents run through the declared wrapper; a command that is already
+ *  wrapped, or doesn't start with the agent's own binary, is left as it is. */
+function withAgentResumeWrapper(
+  agent: TuiAgent,
+  isLocal: boolean,
+  cmdOverrides: Partial<Record<TuiAgent, string>>,
+  recipe: ReturnType<typeof resolveResumeLaunchRecipe>
+): ReturnType<typeof resolveResumeLaunchRecipe> & {
+  cmdOverrides: Partial<Record<TuiAgent, string>>
+} {
+  const wrap = (command: string): string | null =>
+    nixAgentResumeWrapper && new RegExp(`^${agent}(\\s|$)`).test(command.trim())
+      ? `${nixAgentResumeWrapper} ${command.trim()}`
+      : null
+  if (!WRAPPED_RESUME_AGENTS.has(agent) || !isLocal) {
+    return { ...recipe, cmdOverrides }
+  }
+  if (recipe.agentCommand) {
+    return {
+      ...recipe,
+      cmdOverrides,
+      agentCommand: wrap(recipe.agentCommand) ?? recipe.agentCommand
+    }
+  }
+  const command = wrap(
+    cmdOverrides[agent] || getTuiAgentLaunchCommand(TUI_AGENT_CONFIG[agent], 'linux')
+  )
+  return { ...recipe, cmdOverrides: command ? { ...cmdOverrides, [agent]: command } : cmdOverrides }
+}
