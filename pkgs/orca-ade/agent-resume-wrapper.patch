+const WRAPPED_RESUME_AGENTS: ReadonlySet<TuiAgent> = new Set(['claude', 'codex', 'muse', 'antigravity'])
+
+/** Local resumes of these agents run through the declared wrapper as `<wrapper> <agent> <args>`; a
+ *  command that is already wrapped, or doesn't start with the agent's own binary, is left as it is. */
+function withAgentResumeWrapper(
+  agent: TuiAgent,
+  isLocal: boolean,
+  cmdOverrides: Partial<Record<TuiAgent, string>>,
+  recipe: ReturnType<typeof resolveResumeLaunchRecipe>
+): ReturnType<typeof resolveResumeLaunchRecipe> & {
+  cmdOverrides: Partial<Record<TuiAgent, string>>
+} {
+  const binary = getTuiAgentLaunchCommand(TUI_AGENT_CONFIG[agent], 'linux')
+  const wrap = (command: string): string | null => {
+    const trimmed = command.trim()
+    return nixAgentResumeWrapper &&
+      (trimmed === binary || trimmed.startsWith(`${binary} `) || trimmed.startsWith(`${binary}\t`))
+      ? `${nixAgentResumeWrapper} ${agent}${trimmed.slice(binary.length)}`
+      : null
+  }
+  if (!WRAPPED_RESUME_AGENTS.has(agent) || !isLocal) {
+    return { ...recipe, cmdOverrides }
+  }
+  if (recipe.agentCommand) {
+    return {
+      ...recipe,
+      cmdOverrides,
+      agentCommand: wrap(recipe.agentCommand) ?? recipe.agentCommand
+    }
+  }
+  const command = wrap(
+    cmdOverrides[agent] || getTuiAgentLaunchCommand(TUI_AGENT_CONFIG[agent], 'linux')
+  )
+  return { ...recipe, cmdOverrides: command ? { ...cmdOverrides, [agent]: command } : cmdOverrides }
+}
