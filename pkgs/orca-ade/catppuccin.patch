+import type * as Monaco from 'monaco-editor'
+import type { PluginThemeTokenColorRule } from '../../../shared/plugins/artifacts/plugin-theme-artifact'
+import { pluginMonacoTokenRules } from './plugin-monaco-token-rules'
+
+export const CATPPUCCIN_MOCHA_MONACO_THEME = 'catppuccin-mocha'
+
+// vale-c/orca-catppuccin's Mocha syntax colors, mapped the way Orca maps a plugin theme's.
+const tokenColors: PluginThemeTokenColorRule[] = [
+  {
+    scope: ['comment', 'punctuation.definition.comment'],
+    settings: { foreground: '#9399B2', fontStyle: 'italic' }
+  },
+  { scope: ['variable', 'support.variable'], settings: { foreground: '#CDD6F4' } },
+  { scope: ['variable.parameter'], settings: { foreground: '#EBA0AC' } },
+  { scope: ['variable.language', 'support.function.builtin'], settings: { foreground: '#F38BA8' } },
+  {
+    scope: ['constant', 'support.constant', 'variable.other.constant'],
+    settings: { foreground: '#FAB387' }
+  },
+  { scope: ['constant.numeric'], settings: { foreground: '#FAB387' } },
+  { scope: ['constant.other.symbol'], settings: { foreground: '#F38BA8' } },
+  { scope: ['variable.other.enummember'], settings: { foreground: '#94E2D5' } },
+  { scope: ['keyword', 'storage.type', 'storage.modifier'], settings: { foreground: '#CBA6F7' } },
+  { scope: ['keyword.operator'], settings: { foreground: '#89DCEB' } },
+  {
+    scope: ['string', 'punctuation.definition.string', 'markup.inline.raw', 'markup.raw'],
+    settings: { foreground: '#A6E3A1' }
+  },
+  { scope: ['constant.character.escape', 'string.regexp'], settings: { foreground: '#F5C2E7' } },
+  { scope: ['entity.name.function', 'support.function'], settings: { foreground: '#89B4FA' } },
+  {
+    scope: ['entity.name.function.macro', 'meta.preprocessor'],
+    settings: { foreground: '#F5E0DC' }
+  },
+  {
+    scope: [
+      'entity.name.type',
+      'entity.name.class',
+      'entity.name.namespace',
+      'entity.other.inherited-class',
+      'support.type',
+      'support.class',
+      'storage.type.annotation'
+    ],
+    settings: { foreground: '#F9E2AF' }
+  },
+  { scope: ['punctuation', 'meta.brace'], settings: { foreground: '#9399B2' } },
+  { scope: ['entity.name.tag'], settings: { foreground: '#89B4FA' } },
+  { scope: ['entity.other.attribute-name'], settings: { foreground: '#F9E2AF' } },
+  { scope: ['support.type.property-name'], settings: { foreground: '#89B4FA' } },
+  {
+    scope: ['meta.decorator', 'entity.name.function.decorator'],
+    settings: { foreground: '#F9E2AF' }
+  },
+  {
+    scope: ['markup.heading', 'entity.name.section'],
+    settings: { foreground: '#F38BA8', fontStyle: 'bold' }
+  },
+  { scope: ['markup.bold'], settings: { fontStyle: 'bold' } },
+  { scope: ['markup.italic'], settings: { fontStyle: 'italic' } },
+  {
+    scope: ['markup.underline.link', 'string.other.link'],
+    settings: { foreground: '#89B4FA', fontStyle: 'underline' }
+  },
+  { scope: ['markup.quote'], settings: { foreground: '#9399B2', fontStyle: 'italic' } },
+  { scope: ['markup.inserted'], settings: { foreground: '#A6E3A1' } },
+  { scope: ['markup.deleted'], settings: { foreground: '#F38BA8' } },
+  { scope: ['markup.changed'], settings: { foreground: '#89B4FA' } },
+  { scope: ['invalid'], settings: { foreground: '#F38BA8' } }
+]
+
+export const catppuccinMochaTheme: Monaco.editor.IStandaloneThemeData = {
+  base: 'vs-dark',
+  inherit: true,
