 }
 
+// Why: worktrees should start from the local default branch, which may be ahead of the remote.
+async function preferLocalDefaultBranch(
+  defaultBaseRef: string,
+  isBaseUsable: (baseBranch: string) => Promise<boolean>
+): Promise<string> {
+  const branch = defaultBaseRef.startsWith('origin/') ? defaultBaseRef.slice('origin/'.length) : ''
+  return branch && (await isBaseUsable(branch)) ? branch : defaultBaseRef
+}
+
 export async function resolveWorktreeCreateBase(
   args: ResolveWorktreeCreateBaseArgs
 ): Promise<string | null> {
@@ -15,7 +24,7 @@ export async function resolveWorktreeCreateBase(
   const defaultBaseRef = await args.resolveDefaultBaseRef()
   const repoWorktreeBaseRef = args.repoWorktreeBaseRef
   if (!repoWorktreeBaseRef) {
-    return defaultBaseRef
+    return defaultBaseRef && preferLocalDefaultBranch(defaultBaseRef, args.isBaseUsable)
   }
   if (!defaultBaseRef) {
     return (await args.isBaseUsable(repoWorktreeBaseRef)) ? repoWorktreeBaseRef : null
@@ -24,5 +33,7 @@ export async function resolveWorktreeCreateBase(
     return repoWorktreeBaseRef
   }
   // Stale persisted refs fall back to the detected default; usable custom refs stay authoritative.
-  return (await args.isBaseUsable(repoWorktreeBaseRef)) ? repoWorktreeBaseRef : defaultBaseRef
+  return (await args.isBaseUsable(repoWorktreeBaseRef))
+    ? repoWorktreeBaseRef
+    : preferLocalDefaultBranch(defaultBaseRef, args.isBaseUsable)
 }
