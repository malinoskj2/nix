--- /dev/null
+++ b/src/main/workspaces/creation/nix-worktree-create-base.test.ts
@@ -0,0 +1,53 @@
+import { describe, expect, it } from 'vitest'
+import { resolveWorktreeCreateBase } from './worktree-create-base'
+
+const resolve = (args: {
+  requestedBaseBranch?: string
+  repoWorktreeBaseRef?: string | null
+  defaultBaseRef: string | null
+  usable: string[]
+}) =>
+  resolveWorktreeCreateBase({
+    requestedBaseBranch: args.requestedBaseBranch,
+    repoWorktreeBaseRef: args.repoWorktreeBaseRef,
+    resolveDefaultBaseRef: async () => args.defaultBaseRef,
+    isBaseUsable: async (candidate) => args.usable.includes(candidate)
+  })
+
+describe('default worktree base', () => {
+  it('prefers the local branch of the detected remote default', async () => {
+    await expect(
+      resolve({ defaultBaseRef: 'origin/main', usable: ['main', 'origin/main'] })
+    ).resolves.toBe('main')
+  })
+
+  it('keeps the remote default when no local branch of that name exists', async () => {
+    await expect(resolve({ defaultBaseRef: 'origin/main', usable: ['origin/main'] })).resolves.toBe(
+      'origin/main'
+    )
+    await expect(resolve({ defaultBaseRef: null, usable: ['main'] })).resolves.toBeNull()
+  })
+
+  it('lets an explicit or persisted base win', async () => {
+    const usable = ['main', 'origin/main', 'origin/release']
+    await expect(
+      resolve({ requestedBaseBranch: 'origin/main', defaultBaseRef: 'origin/main', usable })
+    ).resolves.toBe('origin/main')
+    await expect(
+      resolve({ repoWorktreeBaseRef: 'origin/main', defaultBaseRef: 'origin/main', usable })
+    ).resolves.toBe('origin/main')
+    await expect(
+      resolve({ repoWorktreeBaseRef: 'origin/release', defaultBaseRef: 'origin/main', usable })
+    ).resolves.toBe('origin/release')
+  })
+
+  it('falls back from a stale persisted base to the local default branch', async () => {
+    await expect(
+      resolve({
+        repoWorktreeBaseRef: 'origin/gone',
+        defaultBaseRef: 'origin/main',
+        usable: ['main', 'origin/main']
+      })
+    ).resolves.toBe('main')
+  })
+})
