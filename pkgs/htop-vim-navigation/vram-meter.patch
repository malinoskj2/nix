diff --git a/linux/VRAMMeter.c b/linux/VRAMMeter.c
new file mode 100644
index 0000000..c62f103
--- /dev/null
+++ b/linux/VRAMMeter.c
@@ -0,0 +1,134 @@
+/*
+htop - linux/VRAMMeter.c
+Released under the GNU GPLv2+, see the COPYING file
+in the source distribution for its full text.
+*/
+
+#include "config.h" // IWYU pragma: keep
+
+#include "linux/VRAMMeter.h"
+
+#include <dlfcn.h>
+#include <stdbool.h>
+#include <stddef.h>
+
+#include "CRT.h"
+#include "Meter.h"
+#include "Object.h"
+#include "RichString.h"
+#include "XUtils.h"
+
+
+typedef struct {
+   unsigned long long total;
+   unsigned long long free;
+   unsigned long long used;
+} NvmlMemory;
+
+typedef int (*NvmlInit)(void);
+typedef int (*NvmlDeviceCount)(unsigned int*);
+typedef int (*NvmlDeviceByIndex)(unsigned int, void**);
+typedef int (*NvmlDeviceMemory)(void*, NvmlMemory*);
+
+static struct {
+   bool tried;
+   bool ready;
+   unsigned int count;
+   NvmlDeviceByIndex byIndex;
+   NvmlDeviceMemory memory;
+} nvml;
+
+static void* openNvml(void) {
+   static const char* const names[] = {
+      "libnvidia-ml.so.1",
+      "/run/opengl-driver/lib/libnvidia-ml.so.1",
+   };
+   for (size_t i = 0; i < ARRAYSIZE(names); i++) {
+      void* handle = dlopen(names[i], RTLD_LAZY | RTLD_LOCAL);
+      if (handle)
+         return handle;
+   }
+   return NULL;
+}
+
+static void loadNvml(void) {
+   nvml.tried = true;
+
+   void* handle = openNvml();
+   if (!handle)
+      return;
+
+   NvmlInit init = (NvmlInit)dlsym(handle, "nvmlInit_v2");
+   NvmlDeviceCount count = (NvmlDeviceCount)dlsym(handle, "nvmlDeviceGetCount_v2");
+   nvml.byIndex = (NvmlDeviceByIndex)dlsym(handle, "nvmlDeviceGetHandleByIndex_v2");
+   nvml.memory = (NvmlDeviceMemory)dlsym(handle, "nvmlDeviceGetMemoryInfo");
+   if (!init || !count || !nvml.byIndex || !nvml.memory || init() != 0 || count(&nvml.count) != 0)
+      return;
+
+   nvml.ready = true;
+}
+
+static void VRAMMeter_updateValues(Meter* this) {
+   if (!nvml.tried)
+      loadNvml();
+
+   unsigned long long total = 0;
+   unsigned long long used = 0;
+   if (nvml.ready) {
+      for (unsigned int i = 0; i < nvml.count; i++) {
+         void* device;
+         NvmlMemory memory;
+         if (nvml.byIndex(i, &device) == 0 && nvml.memory(device, &memory) == 0) {
+            total += memory.total;
+            used += memory.used;
+         }
+      }
+   }
+
+   this->total = total / 1024.0;
+   this->values[0] = used / 1024.0;
+
+   if (total == 0) {
+      xSnprintf(this->txtBuffer, sizeof(this->txtBuffer), "N/A");
+      return;
+   }
+
+   char usedText[16];
+   char totalText[16];
+   Meter_humanUnit(usedText, this->values[0], sizeof(usedText));
+   Meter_humanUnit(totalText, this->total, sizeof(totalText));
+   xSnprintf(this->txtBuffer, sizeof(this->txtBuffer), "%s/%s", usedText, totalText);
+}
+
+static void VRAMMeter_display(const Object* cast, RichString* out) {
+   const Meter* this = (const Meter*)cast;
+   char buffer[16];
+
+   RichString_writeAscii(out, CRT_colors[METER_TEXT], ":");
+   Meter_humanUnit(buffer, this->total, sizeof(buffer));
+   RichString_appendAscii(out, CRT_colors[METER_VALUE], buffer);
+   Meter_humanUnit(buffer, this->values[0], sizeof(buffer));
+   RichString_appendAscii(out, CRT_colors[METER_TEXT], " used:");
+   RichString_appendAscii(out, CRT_colors[METER_VALUE], buffer);
+}
+
+static const int VRAMMeter_attributes[] = {
+   MEMORY_1,
+};
+
+const MeterClass VRAMMeter_class = {
+   .super = {
+      .extends = Class(Meter),
+      .delete = Meter_delete,
+      .display = VRAMMeter_display,
+   },
+   .updateValues = VRAMMeter_updateValues,
+   .defaultMode = BAR_METERMODE,
+   .supportedModes = METERMODE_DEFAULT_SUPPORTED,
+   .maxItems = 1,
+   .total = 100.0,
+   .attributes = VRAMMeter_attributes,
+   .name = "VRAM",
+   .uiName = "VRAM",
+   .caption = "VRM"
+};
