+def isolate_stdio_protocol() -> TextIOWrapper:
+    """Keep Ghidra's fd 1 output off the MCP JSON-RPC stream."""
+    sys.stdout.flush()
+    protocol = TextIOWrapper(os.fdopen(os.dup(1), "wb"), encoding="utf-8")
+    os.dup2(2, 1)
+    return protocol
+
+
+_stdio_protocol: TextIOWrapper | None = None
+
+
+async def run_stdio_server(mcp: MCPServer) -> None:
+    async with stdio_server(stdout=anyio.wrap_file(_stdio_protocol)) as (read_stream, write_stream):
+        await mcp._mcp_server.run(
+            read_stream,
+            write_stream,
+            mcp._mcp_server.create_initialization_options(),
+        )
+
