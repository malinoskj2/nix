diff --git a/video/out/vulkan/libmpv_vk.c b/video/out/vulkan/libmpv_vk.c
new file mode 100644
index 0000000..6447784
--- /dev/null
+++ b/video/out/vulkan/libmpv_vk.c
@@ -0,0 +1,111 @@
+#include "common.h"
+#include "context.h"
+#include "mpv/render_vk.h"
+#include "options/m_config.h"
+#include "video/out/gpu/libmpv_gpu.h"
+#include "video/out/placebo/ra_pl.h"
+#include "video/out/placebo/utils.h"
+
+extern const struct m_sub_options vulkan_conf;
+
+struct priv {
+    struct mpvk_ctx vk;
+    struct ra_ctx *ra_ctx;
+    struct ra_tex target;
+};
+
+static int init(struct libmpv_gpu_context *ctx, mpv_render_param *params)
+{
+    ctx->priv = talloc_zero(NULL, struct priv);
+    struct priv *p = ctx->priv;
+
+    mpv_vulkan_init_params *init_params =
+        get_mpv_render_param(params, MPV_RENDER_PARAM_VULKAN_INIT_PARAMS, NULL);
+    if (!init_params || !init_params->device)
+        return MPV_ERROR_INVALID_PARAMETER;
+
+    struct ra_ctx_opts *ctx_opts = mp_get_config_group(p, ctx->global, &ra_ctx_conf);
+
+    p->vk.pllog = mppl_log_create(p, ctx->log);
+    if (!p->vk.pllog)
+        return MPV_ERROR_UNSUPPORTED;
+
+    const char *exts[] = {
+        VK_KHR_SURFACE_EXTENSION_NAME,
+        VK_KHR_WAYLAND_SURFACE_EXTENSION_NAME,
+    };
+    p->vk.vkinst = pl_vk_inst_create(p->vk.pllog, &(struct pl_vk_inst_params) {
+        .debug = ctx_opts->debug,
+        .debug_extra = ctx_opts->debug,
+        .extensions = exts,
+        .num_extensions = MP_ARRAY_SIZE(exts),
+    });
+    if (!p->vk.vkinst)
+        return MPV_ERROR_UNSUPPORTED;
+
+    struct vulkan_opts *vk_opts = mp_get_config_group(p, ctx->global, &vulkan_conf);
+    p->vk.vulkan = mppl_create_vulkan(vk_opts, p->vk.vkinst, p->vk.pllog,
+                                      VK_NULL_HANDLE, false);
+    if (!p->vk.vulkan)
+        return MPV_ERROR_UNSUPPORTED;
+    p->vk.gpu = p->vk.vulkan->gpu;
+
+    p->ra_ctx = talloc_zero(p, struct ra_ctx);
+    p->ra_ctx->log = ctx->log;
+    p->ra_ctx->global = ctx->global;
+    p->ra_ctx->opts = (struct ra_ctx_opts) {
+        .debug = ctx_opts->debug,
+    };
+    p->ra_ctx->ra = ra_create_pl(p->vk.gpu, ctx->log);
+    if (!p->ra_ctx->ra)
+        return MPV_ERROR_UNSUPPORTED;
+
+    // hwdec_vulkan finds the instance and device through this.
+    ra_add_native_resource(p->ra_ctx->ra, "mpvk_ctx", &p->vk);
+
+    ctx->ra_ctx = p->ra_ctx;
+    *init_params->device = p->vk.vulkan;
+    return 0;
+}
+
+static int wrap_fbo(struct libmpv_gpu_context *ctx, mpv_render_param *params,
+                    struct ra_tex **out)
+{
+    struct priv *p = ctx->priv;
+
+    pl_tex tex = get_mpv_render_param(params, MPV_RENDER_PARAM_VULKAN_TEX, NULL);
+    if (!tex)
+        return MPV_ERROR_INVALID_PARAMETER;
+
+    if (!mppl_wrap_tex(p->ra_ctx->ra, tex, &p->target))
+        return MPV_ERROR_UNSUPPORTED;
+
+    *out = &p->target;
+    return 0;
+}
+
+static void done_frame(struct libmpv_gpu_context *ctx, bool ds)
+{
+}
+
+static void destroy(struct libmpv_gpu_context *ctx)
+{
+    struct priv *p = ctx->priv;
+
+    if (p->ra_ctx && p->ra_ctx->ra) {
+        pl_gpu_finish(p->vk.gpu);
+        p->ra_ctx->ra->fns->destroy(p->ra_ctx->ra);
+        p->ra_ctx->ra = NULL;
+    }
+    pl_vulkan_destroy(&p->vk.vulkan);
+    pl_vk_inst_destroy(&p->vk.vkinst);
+    pl_log_destroy(&p->vk.pllog);
+}
+
+const struct libmpv_gpu_context_fns libmpv_gpu_context_vk = {
+    .api_name = MPV_RENDER_API_TYPE_VULKAN,
+    .init = init,
+    .wrap_fbo = wrap_fbo,
+    .done_frame = done_frame,
+    .destroy = destroy,
+};
