+#ifndef MPV_CLIENT_API_RENDER_VK_H_
+#define MPV_CLIENT_API_RENDER_VK_H_
+
+#include <libplacebo/vulkan.h>
+
+#include "render.h"
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+#define MPV_RENDER_API_TYPE_VULKAN "vulkan"
+
+#define MPV_RENDER_PARAM_VULKAN_INIT_PARAMS ((mpv_render_param_type)0x766b0001)
+// pl_tex: the renderable texture mpv_render_context_render() draws into.
+#define MPV_RENDER_PARAM_VULKAN_TEX ((mpv_render_param_type)0x766b0002)
+
+typedef struct mpv_vulkan_init_params {
+    // Receives the device mpv renders with, created on an instance with
+    // VK_KHR_wayland_surface. It lives until the render context is freed, so
+    // swapchains made on it must be destroyed first.
+    pl_vulkan *device;
+} mpv_vulkan_init_params;
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif
