+// "rrggbb", "#rrggbb" or 0xRRGGBB
+static std::optional<std::array<float, 3>> parseGleamColor(lua_State* L, int index) {
+    uint32_t rgb = 0;
+    if (lua_type(L, index) == LUA_TNUMBER) {
+        rgb = static_cast<uint32_t>(lua_tointeger(L, index));
+    } else if (lua_type(L, index) == LUA_TSTRING) {
+        std::string_view hex = lua_tostring(L, index);
+        if (hex.starts_with('#'))
+            hex.remove_prefix(1);
+        if (hex.size() != 6 || std::from_chars(hex.data(), hex.data() + hex.size(), rgb, 16).ptr != hex.data() + hex.size())
+            return std::nullopt;
+    } else {
+        return std::nullopt;
+    }
+    return std::array<float, 3>{((rgb >> 16) & 0xFF) / 255.0f, ((rgb >> 8) & 0xFF) / 255.0f, (rgb & 0xFF) / 255.0f};
+}
+
+static void readGleamNumber(lua_State* L, const char* key, float& out, float min = 0.0f) {
+    lua_getfield(L, 2, key);
+    if (lua_isnumber(L, -1))
+        out = std::max(static_cast<float>(lua_tonumber(L, -1)), min);
+    lua_pop(L, 1);
+}
+
+static std::optional<GlassRenderer::SGleam> parseGleam(lua_State* L) {
+    GlassRenderer::SGleam gleam;
+
+    lua_getfield(L, 2, "gleam_colors");
+    if (lua_istable(L, -1)) {
+        const int count = static_cast<int>(lua_rawlen(L, -1));
+        for (int i = 1; i <= count && gleam.colorCount < GlassRenderer::MAX_GLEAM_COLORS; i++) {
+            lua_rawgeti(L, -1, i);
+            if (auto color = parseGleamColor(L, -1))
+                gleam.colors[gleam.colorCount++] = *color;
+            lua_pop(L, 1);
+        }
+    }
+    lua_pop(L, 1);
+
+    if (gleam.colorCount == 0)
+        return std::nullopt;
+
+    gleam.strength = 1.0f;
+    readGleamNumber(L, "gleam_strength", gleam.strength);
+    readGleamNumber(L, "gleam_width", gleam.width, 0.1f);
+    readGleamNumber(L, "gleam_length", gleam.length, 0.01f);
+    readGleamNumber(L, "gleam_duration", gleam.duration);
+    readGleamNumber(L, "gleam_delay", gleam.delay);
+    readGleamNumber(L, "gleam_rest", gleam.rest);
+    return gleam;
+}
