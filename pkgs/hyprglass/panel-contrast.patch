+// Read a bounded thumbnail of the capsule's cached background. The input region stays at the
+// capsule's full resting size while its visible glass animates, including the one-pixel probe.
+// This happens before the layer is drawn, so changing its ink cannot feed back into the sample.
+void CGlassLayerSurface::reportPanelBackdrop(PHLMONITOR monitor, const CBox& layerBox, const CBox& transformBox) {
+    const auto layer = m_layerSurface.lock();
+    if (!layer || layer->m_namespace != "noctalia-panel" || !g_pEventManager)
+        return;
+    const auto surface = layer->wlSurface();
+    const auto resource = surface ? surface->resource() : nullptr;
+    if (!resource)
+        return;
+    auto input = resource->m_current.effectiveInputRegion();
+    if (input.empty())
+        return;
+    const auto extent = input.getExtents();
+    const auto ratio = regionScale(layer, monitor, layerBox);
+    const auto box = transformedLayerBox(CBox{layerBox.x + extent.x * ratio.x, layerBox.y + extent.y * ratio.y,
+                                               extent.w * ratio.x, extent.h * ratio.y}, monitor);
+    const auto scale = m_sampleFramebuffer->m_size / (transformBox.size() + Vector2D{2 * GlassRenderer::SAMPLE_PADDING_PX, 2 * GlassRenderer::SAMPLE_PADDING_PX});
+    const auto offset = (box.pos() - transformBox.pos() + Vector2D{GlassRenderer::SAMPLE_PADDING_PX, GlassRenderer::SAMPLE_PADDING_PX}) * scale;
+    const auto end = offset + box.size() * scale;
+    const int x0 = std::clamp(static_cast<int>(offset.x), 0, static_cast<int>(m_sampleFramebuffer->m_size.x));
+    const int y0 = std::clamp(static_cast<int>(offset.y), 0, static_cast<int>(m_sampleFramebuffer->m_size.y));
+    const int x1 = std::clamp(static_cast<int>(end.x), x0, static_cast<int>(m_sampleFramebuffer->m_size.x));
+    const int y1 = std::clamp(static_cast<int>(end.y), y0, static_cast<int>(m_sampleFramebuffer->m_size.y));
+    if (x1 <= x0 || y1 <= y0)
+        return;
+
+    constexpr int SIDE = 16;
+    GLint readFB = 0, drawFB = 0, packBuffer = 0, alignment = 0, rowLength = 0, skipRows = 0, skipPixels = 0;
+    glGetIntegerv(GL_READ_FRAMEBUFFER_BINDING, &readFB);
+    glGetIntegerv(GL_DRAW_FRAMEBUFFER_BINDING, &drawFB);
+    glGetIntegerv(GL_PIXEL_PACK_BUFFER_BINDING, &packBuffer);
+    glGetIntegerv(GL_PACK_ALIGNMENT, &alignment);
+    glGetIntegerv(GL_PACK_ROW_LENGTH, &rowLength);
+    glGetIntegerv(GL_PACK_SKIP_ROWS, &skipRows);
+    glGetIntegerv(GL_PACK_SKIP_PIXELS, &skipPixels);
+    const bool scissor = glIsEnabled(GL_SCISSOR_TEST);
+
+    if (!m_contrastFramebuffer)
+        m_contrastFramebuffer = g_pHyprRenderer->createFB("j2bar-panel-contrast");
+    const bool allocated = m_contrastFramebuffer->isAllocated() || m_contrastFramebuffer->alloc(SIDE, SIDE, DRM_FORMAT_ARGB8888);
+    std::array<unsigned char, SIDE * SIDE * 4> pixels{};
+    if (allocated) {
+        g_pHyprOpenGL->setCapStatus(GL_SCISSOR_TEST, false);
+        glBindFramebuffer(GL_READ_FRAMEBUFFER, dynamic_cast<Render::GL::CGLFramebuffer*>(m_sampleFramebuffer.get())->getFBID());
+        glBindFramebuffer(GL_DRAW_FRAMEBUFFER, dynamic_cast<Render::GL::CGLFramebuffer*>(m_contrastFramebuffer.get())->getFBID());
+        glBlitFramebuffer(x0, y0, x1, y1, 0, 0, SIDE, SIDE, GL_COLOR_BUFFER_BIT, GL_LINEAR);
+        glBindFramebuffer(GL_READ_FRAMEBUFFER, dynamic_cast<Render::GL::CGLFramebuffer*>(m_contrastFramebuffer.get())->getFBID());
+        glBindBuffer(GL_PIXEL_PACK_BUFFER, 0);
+        glPixelStorei(GL_PACK_ALIGNMENT, 1);
+        glPixelStorei(GL_PACK_ROW_LENGTH, 0);
+        glPixelStorei(GL_PACK_SKIP_ROWS, 0);
+        glPixelStorei(GL_PACK_SKIP_PIXELS, 0);
+        glReadPixels(0, 0, SIDE, SIDE, GL_RGBA, GL_UNSIGNED_BYTE, pixels.data());
+    }
+    glBindFramebuffer(GL_READ_FRAMEBUFFER, readFB);
+    glBindFramebuffer(GL_DRAW_FRAMEBUFFER, drawFB);
+    glBindBuffer(GL_PIXEL_PACK_BUFFER, packBuffer);
+    glPixelStorei(GL_PACK_ALIGNMENT, alignment);
+    glPixelStorei(GL_PACK_ROW_LENGTH, rowLength);
+    glPixelStorei(GL_PACK_SKIP_ROWS, skipRows);
+    glPixelStorei(GL_PACK_SKIP_PIXELS, skipPixels);
+    g_pHyprOpenGL->setCapStatus(GL_SCISSOR_TEST, scissor);
+    if (!allocated)
+        return;
+
+    int bright = 0;
+    for (size_t i = 0; i < pixels.size(); i += 4)
+        bright += 0.2126F * pixels[i] + 0.7152F * pixels[i + 1] + 0.0722F * pixels[i + 2] > 0.55F * 255.F;
+    const float coverage = static_cast<float>(bright) / (SIDE * SIDE);
+    bool light = m_lightBackdrop.value_or(false);
+    if (coverage > 0.55F)
+        light = true;
+    else if (coverage < 0.45F)
+        light = false;
+    if (!m_lightBackdrop || light != *m_lightBackdrop) {
+        m_lightBackdrop = light;
+        g_pEventManager->postEvent({"j2barpanelcontrast", std::format("{},{}", monitor->m_name, light ? 1 : 0)});
+    }
 }

